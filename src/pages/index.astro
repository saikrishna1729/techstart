---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

// Fetch all blog posts and sort them by publication date (newest first)
const allPosts = await getCollection("blog");
const latestPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4); // Limit to the latest 4 posts
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>TechStart.Cloud | Saikrishna Nagisetti</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--primary-color: #4f46e5;
				--text-color: #333;
				--bg-color: #f9fafb;
				--card-bg: #ffffff;
			}
			body {
				font-family: "Inter", sans-serif;
				margin: 0;
				padding: 0;
				color: var(--text-color);
				background-color: var(--bg-color);
				line-height: 1.6;
			}
			.hero {
				padding: 4rem 0;
				text-align: center;
			}
			.hero h1 {
				font-size: 3rem;
				margin-bottom: 1rem;
			}
			.hero p {
				font-size: 1.25rem;
				color: #666;
				max-width: 600px;
				margin: 0 auto;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				padding: 2rem 0;
			}
			.post-card {
				background: var(--card-bg);
				border-radius: 0.5rem;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
				transition: transform 0.3s ease;
			}
			.post-card:hover {
				transform: translateY(-5px);
			}
			.post-image {
				width: 100%;
				height: 200px;
				object-fit: cover;
			}
			.post-content {
				padding: 1.5rem;
			}
			.post-title {
				font-size: 1.25rem;
				margin: 0 0 0.5rem 0;
			}
			.post-description {
				color: #666;
				margin: 0 0 1rem 0;
			}
			.post-date {
				color: #888;
				font-size: 0.875rem;
			}
			.btn {
				display: inline-block;
				background-color: var(--primary-color);
				color: white;
				padding: 0.75rem 1.5rem;
				border-radius: 0.25rem;
				text-decoration: none;
				font-weight: 600;
				transition: background-color 0.3s ease;
			}
			.btn:hover {
				background-color: #4338ca;
			}
		</style>
	</head>
	<body>
		<Header />

		<main>
			<section class="hero container">
				<h1>Welcome to TechStart.Cloud</h1>
				<p>
					Hi, I'm Saikrishna Nagisetti. I share my thoughts, ideas, and
					knowledge about web development, cloud computing, and the latest in
					technology.
				</p>
				<div style="margin-top: 2rem;">
					<a href="/blog" class="btn">Browse All Posts</a>
				</div>
			</section>

			<section class="container">
				<h2>Latest Posts</h2>
				<div class="posts-grid">
					{
						// Map through latestPosts array and render each post
						latestPosts.map((post) => (
							<article class="post-card">
								<img
									src={post.data.cover}
									alt={post.data.title}
									class="post-image"
									loading="lazy"
									sizes="(max-width: 600px) 100vw, 50vw"
								/>
								<div class="post-content">
									<h3 class="post-title">
										<a
											href={`/blog/${post.slug}/`}
											style="text-decoration: none; color: inherit;"
										>
											{post.data.title}
										</a>
									</h3>
									<p class="post-description">{post.data.description}</p>
									<p class="post-date">
										{new Date(post.data.pubDate).toDateString()}
									</p>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
