---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

// Get all blog posts sorted by publication date (newest first)
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<MainLayout title="Blog | Sai Krishna">
	<div class="container mx-auto px-4 py-12">
		<header class="mb-12">
			<h1 class="text-4xl font-bold mb-4">Blog Posts</h1>
			<p class="text-xl text-gray-600 dark:text-gray-300">
				Thoughts, tutorials, and insights on web development and technology
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{
				sortedPosts.map((post) => (
					<article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden transition hover:translate-y-[-5px] hover:shadow-lg">
						{post.data.cover && (
							<img
								src={post.data.cover}
								alt={post.data.title}
								class="w-full h-48 object-cover"
							/>
						)}
						<div class="p-6">
							<h3 class="text-xl font-bold mb-2">
								<a href={`/blog/${post.slug}/`} class="hover:text-primary">
									{post.data.title}
								</a>
							</h3>
							<p class="text-gray-600 dark:text-gray-300 mb-4">
								{post.data.description}
							</p>
							<div class="flex justify-between items-center">
								<p class="text-gray-500 text-sm">
									{new Date(post.data.pubDate).toLocaleDateString()}
								</p>
								{post.data.tags && (
									<div class="flex flex-wrap gap-2">
										{post.data.tags.slice(0, 2).map((tag) => (
											<span class="bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs px-2 py-1 rounded">
												{tag}
											</span>
										))}
									</div>
								)}
							</div>
						</div>
					</article>
				))
			}
		</div>

		{
			sortedPosts.length === 0 && (
				<div class="text-center py-12">
					<p class="text-gray-500">No posts available yet. Check back soon!</p>
				</div>
			)
		}
	</div>
</MainLayout>
