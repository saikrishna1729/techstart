---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Array of blog posts
const allPosts = [
	{
		url: "/blog/hello-world",
		frontmatter: {
			title: "Getting Started with Astro",
			description: "Learn how to build lightning-fast websites with Astro",
			pubDate: new Date("2023-04-15"),
			cover: "https://picsum.photos/800/400",
		},
	},
	{
		url: "#",
		frontmatter: {
			title: "CSS Tips and Tricks",
			description: "Enhance your styling skills with these CSS techniques",
			pubDate: new Date("2023-04-10"),
			cover: "https://picsum.photos/800/401",
		},
	},
	{
		url: "#",
		frontmatter: {
			title: "JavaScript Best Practices",
			description: "Write cleaner, more maintainable JavaScript code",
			pubDate: new Date("2023-04-05"),
			cover: "https://picsum.photos/800/402",
		},
	},
	{
		url: "#",
		frontmatter: {
			title: "Understanding React Hooks",
			description:
				"A deep dive into React Hooks and how to use them effectively",
			pubDate: new Date("2023-04-01"),
			cover: "https://picsum.photos/800/403",
		},
	},
];
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>TechStart.Cloud | Saikrishna Nagisetti</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--primary-color: #4f46e5;
				--text-color: #333;
				--bg-color: #f9fafb;
				--card-bg: #ffffff;
			}
			body {
				font-family: "Inter", sans-serif;
				margin: 0;
				padding: 0;
				color: var(--text-color);
				background-color: var(--bg-color);
				line-height: 1.6;
			}
			.hero {
				padding: 4rem 0;
				text-align: center;
			}
			.hero h1 {
				font-size: 3rem;
				margin-bottom: 1rem;
			}
			.hero p {
				font-size: 1.25rem;
				color: #666;
				max-width: 600px;
				margin: 0 auto;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				padding: 2rem 0;
			}
			.post-card {
				background: var(--card-bg);
				border-radius: 0.5rem;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
				transition: transform 0.3s ease;
			}
			.post-card:hover {
				transform: translateY(-5px);
			}
			.post-image {
				width: 100%;
				height: 200px;
				object-fit: cover;
			}
			.post-content {
				padding: 1.5rem;
			}
			.post-title {
				font-size: 1.25rem;
				margin: 0 0 0.5rem 0;
			}
			.post-description {
				color: #666;
				margin: 0 0 1rem 0;
			}
			.post-date {
				color: #888;
				font-size: 0.875rem;
			}
			.btn {
				display: inline-block;
				background-color: var(--primary-color);
				color: white;
				padding: 0.75rem 1.5rem;
				border-radius: 0.25rem;
				text-decoration: none;
				font-weight: 600;
				transition: background-color 0.3s ease;
			}
			.btn:hover {
				background-color: #4338ca;
			}
		</style>
	</head>
	<body>
		<Header />

		<main>
			<section class="hero container">
				<h1>Welcome to TechStart.Cloud</h1>
				<p>
					Hi, I'm Saikrishna Nagisetti. I share my thoughts, ideas, and
					knowledge about web development, cloud computing, and the latest in
					technology.
				</p>
				<div style="margin-top: 2rem;">
					<a href="/blog" class="btn">Browse All Posts</a>
				</div>
			</section>

			<section class="container">
				<h2>Latest Posts</h2>
				<div class="posts-grid">
					{
						// Map through allPosts array and render each post
						allPosts.map((post) => (
							<article class="post-card">
								<img
									src={post.frontmatter.cover}
									alt={post.frontmatter.title}
									class="post-image"
									loading="lazy"
									sizes="(max-width: 600px) 100vw, 50vw"
								/>
								<div class="post-content">
									<h3 class="post-title">
										<a
											href={post.url}
											style="text-decoration: none; color: inherit;"
										>
											{post.frontmatter.title}
										</a>
									</h3>
									<p class="post-description">{post.frontmatter.description}</p>
									<p class="post-date">
										{post.frontmatter.pubDate.toDateString()}
									</p>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
