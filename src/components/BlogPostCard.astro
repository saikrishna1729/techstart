---
import FormattedDate from "./FormattedDate.astro";
import TagList from "./TagList.astro";

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<article class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
	{
		heroImage && (
			<a href={`/blog/${post.slug}/`}>
				<img
					src={heroImage}
					alt={title}
					class="w-full h-48 object-cover hover:opacity-90 transition"
				/>
			</a>
		)
	}
	<div class="p-6">
		<h2 class="text-2xl font-bold mb-2">
			<a href={`/blog/${post.slug}/`} class="hover:text-primary transition"
				>{title}</a
			>
		</h2>
		<div class="flex items-center text-gray-600 dark:text-gray-400 mb-4">
			<FormattedDate date={pubDate} />
		</div>
		{tags && <TagList tags={tags} />}
		<p class="text-gray-700 dark:text-gray-300 mt-4">{description}</p>
		<a
			href={`/blog/${post.slug}/`}
			class="inline-block mt-4 text-primary hover:text-secondary transition"
		>
			Read more →
		</a>
	</div>
</article>
