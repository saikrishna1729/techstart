---
/**
 * Footer Component
 *
 * Displays the site footer with copyright information and navigation links.
 * Includes client-side script to ensure consistent branding.
 */
import { SITE, NAVIGATION, SOCIAL_LINKS } from "../utils/site-config";

// Get current year for copyright
const currentYear = new Date().getFullYear();

// Site branding
const siteName = SITE.name;
---

<footer class="bg-gray-900 text-white p-4 mt-8">
	<div class="container mx-auto text-center">
		<!-- Copyright section with dynamic year -->
		<p class="footer-copyright">
			© {currentYear}
			{siteName}. All rights reserved.
		</p>

		<!-- Footer navigation -->
		<div class="mt-2">
			{
				NAVIGATION.map((link, index) => (
					<a href={link.path} class="text-gray-400 hover:text-white mx-2">
						{link.name}
					</a>
				))
			}
		</div>

		<!-- Social links if available -->
		{
			Object.keys(SOCIAL_LINKS).length > 0 && (
				<div class="mt-4 flex justify-center space-x-4">
					{Object.entries(SOCIAL_LINKS).map(([platform, url]) => (
						<a
							href={url}
							target="_blank"
							rel="noopener noreferrer"
							class="text-gray-400 hover:text-white"
							aria-label={`Visit our ${platform} page`}
						>
							{platform.charAt(0).toUpperCase() + platform.slice(1)}
						</a>
					))}
				</div>
			)
		}
	</div>
</footer>

<!-- Client-side script for footer text consistency -->
<script define:vars={{ siteName, currentYear }}>
	document.addEventListener("DOMContentLoaded", function () {
		const footerParagraphs = document.querySelectorAll("footer p");
		const correctText = `© ${currentYear} ${siteName}. All rights reserved.`;

		footerParagraphs.forEach((p) => {
			if (
				p.textContent.includes("Saikrishna Nagisetti") ||
				p.textContent.toLowerCase().includes("rights reserved")
			) {
				// Only replace if it's not already our correct text
				if (p.textContent.trim() !== correctText.trim()) {
					p.innerHTML = correctText;
				}
			}
		});
	});
</script>
